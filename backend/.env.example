MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=anonspace

JWT_SECRET=change-this-to-a-long-random-string
JWT_TTL=604800

# Comma-separated list of exact frontend origins to allow. Outside production
# (APP_ENV=production), any origin on a private LAN address (10.x, 172.16-31.x,
# 192.168.x, localhost) is also allowed automatically, so this doesn't need updating
# every time a phone/tablet's DHCP-assigned IP changes.
CORS_ORIGIN=http://localhost:3000

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM_EMAIL=your-gmail-address@gmail.com
SMTP_FROM_NAME=AnonSpace
